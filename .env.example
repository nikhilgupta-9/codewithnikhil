# ==============================================================================
# NikhilWorks - Social Media Automation Environment Configuration
# Save a copy as .env in the project root. DO NOT commit .env to public git.
# ==============================================================================

APP_ENV=local                          # local | production
DRY_RUN=true                           # true (simulate payloads & log only) | false (live API dispatch)
TIMEZONE=Asia/Kolkata
SITE_URL=https://nikhilworks.com

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (PDO)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nikhil_works_db
DB_USER=root
DB_PASS=
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# ------------------------------------------------------------------------------
# ANTHROPIC CLAUDE API (For Viral Topic Suggestions & Deep SEO Article Writing)
# Obtain at: https://console.anthropic.com/settings/keys
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# GOOGLE GEMINI API (For Captions & Imagen Cover Images)
# Obtain at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# ------------------------------------------------------------------------------
# DEV.TO (FOREM API)
# Obtain at: https://dev.to/settings/extensions -> Generate API Key
# ------------------------------------------------------------------------------
DEVTO_API_KEY=your_devto_api_key_here

# ------------------------------------------------------------------------------
# HASHNODE (GRAPHQL API v2)
# Obtain at: https://hashnode.com/settings/developer -> Personal Access Token
# Publication ID at: Hashnode Blog Dashboard -> Settings -> General -> Publication ID
# ------------------------------------------------------------------------------
HASHNODE_API_TOKEN=your_hashnode_personal_access_token
HASHNODE_PUBLICATION_ID=your_hashnode_publication_id_here

# ------------------------------------------------------------------------------
# LINKEDIN REST API (COMMUNITY MANAGEMENT / POSTS)
# Obtain at: https://www.linkedin.com/developers/apps -> Create App -> Request "w_member_social" & "openid"
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://nikhilworks.com/admin/social-oauth.php?provider=linkedin
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_user_oauth2_token_here
ADMIN_ALERT_EMAIL=iamnikhilgupta9@gmail.com

# ------------------------------------------------------------------------------
# X (TWITTER) API v2 (POST /2/tweets)
# Obtain at: https://developer.x.com/en/portal/dashboard -> Create Project & App with OAuth 2.0 User Context
# ------------------------------------------------------------------------------
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=https://nikhilworks.com/admin/social-oauth.php?provider=x
X_BEARER_TOKEN=your_x_user_oauth2_bearer_or_access_token_here
X_DEFAULT_ENABLED=false                # X posting costs/credits toggle (defaults to false)

# ------------------------------------------------------------------------------
# YOUTUBE DATA API v3 (For Testimonial Video Uploads)
# Obtain at: https://console.cloud.google.com/apis/credentials -> Create OAuth 2.0 Client ID & enable YouTube Data API v3
# ------------------------------------------------------------------------------
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_oauth2_refresh_token_here
YOUTUBE_PRIVACY_STATUS=private          # private (default) | unlisted | public
